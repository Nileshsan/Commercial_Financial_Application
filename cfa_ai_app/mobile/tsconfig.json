{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "services/*": [
        "./services/*"
      ],
      "components/*": [
        "./app/components/*"
      ]
    },
    "jsx": "react-native",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "types": [
      "react",
      "react-native",
      "node",
      "@expo/vector-icons"
    ],
    "moduleResolution": "bundler",
    "module": "esnext",
    "lib": [
      "es2020",
      "dom"
    ],
    "noEmit": true,
    "isolatedModules": true,
    "strict": false,
    "noImplicitAny": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "ESNext"
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "types.d.ts",
    "src/types/*.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
