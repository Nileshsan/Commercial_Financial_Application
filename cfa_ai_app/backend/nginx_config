server {
    listen 80;
    server_name cfa.pbssolutions.in;

    location = /favicon.ico { access_log off; log_not_found off; }
    
    location /static/ {
        root /path/to/your/cfa_ai_app/backend;
    }

    location /media/ {
        root /path/to/your/cfa_ai_app/backend;
    }

    location / {
        include proxy_params;
        proxy_pass http://unix:/run/gunicorn.sock;
    }
}
